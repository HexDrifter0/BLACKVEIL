# Required. Render PostgreSQL connection string; use postgresql+psycopg://...
DATABASE_URL=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CONTINUITY_API_TOKEN=

# Supervisor policy
SUPERVISOR_INTERVAL_SECONDS=300
CONTEXT_CHECKPOINT_PERCENT=75
CONTEXT_HARD_LIMIT_PERCENT=80
APPROVAL_POLICY=critical
AUTONOMY_MODE=autonomous

# Provider mapping. No provider is enabled until its secrets are configured.
BLACKVEIL_PROVIDER=openai
BLACKVEIL_MODEL=gpt-6
BLACKVEIL_OPENAI_API_KEY=
BLACKVEIL_AGENT_WEBHOOK_URL=
BLACKVEIL_AGENT_WEBHOOK_TOKEN=

THE_HIDDEN_TRUTH_PROVIDER=webhook
THE_HIDDEN_TRUTH_MODEL=
THE_HIDDEN_TRUTH_OPENAI_API_KEY=
THE_HIDDEN_TRUTH_AGENT_WEBHOOK_URL=
THE_HIDDEN_TRUTH_AGENT_WEBHOOK_TOKEN=

# Repository identifiers only; tokens must be separate secret values.
BLACKVEIL_REPOSITORY=HexDrifter0/BLACKVEIL
THE_HIDDEN_TRUTH_REPOSITORY=HexDrifter0/the-archivits-files
BLACKVEIL_GITHUB_TOKEN=
THE_HIDDEN_TRUTH_GITHUB_TOKEN=
